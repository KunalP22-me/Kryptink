<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Kryptink</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js"></script>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">
            <div class="logo-icon"></div>
            <span class="logo-text">Kryptink</span>
        </div>
        <div class="navbar-right">
            <button class="room-badge copy-room" onclick="copyRoomCode('<%= room.code %>')" title="Click to copy code"><%= room.code %> 📋</button>
            <span class="timer-text" id="timer"></span>
            <button id="themeToggle" class="theme-toggle" onclick="toggleTheme()">🌙</button>
            <a href="/note/create" class="btn btn-primary btn-sm">+ New Note</a>
            <a href="/leave" class="btn btn-outline btn-sm">Leave</a>
        </div>
    </nav>

    <!-- Dashboard -->
    <div class="dashboard">
        <div class="dashboard-header">
            <h2>Your Notes <span class="notes-count"><%= room.notes.length %></span></h2>
        </div>

        <% if (room.notes.length === 0) { %>
            <div class="empty-state">
                <span>📄</span>
                No notes yet. Create your first note!
            </div>
        <% } else { %>
            <div class="notes-grid">
                <% room.notes.forEach(function(note) { %>
                    <div class="note-card">
                        <h3><%= note.title %></h3>
                        <% var plainText = note.content.replace(/<[^>]*>/g, ''); %>
                        <p class="note-preview"><%= plainText.substring(0, 100) %><%= plainText.length > 100 ? '...' : '' %></p>
                        <p class="note-date"><%= new Date(note.createdAt).toLocaleDateString() %></p>
                        <div class="note-actions">
                            <a href="/note/<%= note._id %>">View</a>
                            <a href="/note/edit/<%= note._id %>">Edit</a>
                            <form action="/note/delete/<%= note._id %>" method="POST" style="display:inline">
                                <button type="submit" class="delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- Countdown Timer -->
    <script>
        const expiresAt = new Date("<%= room.expiresAt %>").getTime();

        function updateTimer() {
            const now = Date.now();
            const diff = expiresAt - now;

            if (diff <= 0) {
                document.getElementById("timer").textContent = "Expired!";
                window.location.href = "/";
                return;
            }

            const hours = Math.floor(diff / (1000 * 60 * 60));
            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById("timer").textContent = hours + "h " + mins + "m left";
        }

        updateTimer();
        setInterval(updateTimer, 60000);

        function copyRoomCode(code) {
            const btn = document.querySelector('.copy-room');
            const original = btn.innerHTML;
            
            function showSuccess() {
                btn.innerHTML = 'Copied! ✓';
                setTimeout(() => { btn.innerHTML = original; }, 1500);
            }

            // Fallback for non-HTTPS connections (like testing locally on an IP address)
            function fallbackCopy(text) {
                var textArea = document.createElement("textarea");
                textArea.style.position = "fixed";
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                try {
                    document.execCommand('copy');
                    showSuccess();
                } catch (err) {
                    alert("Could not copy code. Please copy it manually.");
                }
                document.body.removeChild(textArea);
            }

            // Modern API requires HTTPS
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(showSuccess).catch(() => fallbackCopy(code));
            } else {
                fallbackCopy(code);
            }
        }
    </script>

    <!-- Footer -->
    <footer class="footer no-print">
        Made with ❤️ by <a href="https://github.com/kunalp22-me" target="_blank" class="footer-link">
            <svg class="footer-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Creator
        </a>
    </footer>
</body>
</html>
